@tool
extends EditorScript

# Generated by `python -m build godot-theme`. Open it in the script editor and run File > Run.
const SETTINGS = {
	"interface/theme/style": "Modern",
	"interface/theme/color_preset": "Custom",
	"interface/theme/base_color": Color("#18181b"),
	"interface/theme/accent_color": Color("#ff637e"),
	"interface/theme/contrast": 0.3,
}


func _run() -> void:
	var editor_settings := EditorInterface.get_editor_settings()
	for key: String in SETTINGS:
		editor_settings.set_setting(key, SETTINGS[key])
